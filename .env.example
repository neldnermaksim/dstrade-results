# Адрес основного сайта DSTrade — используется в ссылках «Войти», «Регистрация», «Тарифы».
VITE_APP_ORIGIN=https://dstrade.io

# Источник данных: "mock" — встроенные демо-данные, "api" — реальный бэкенд.
VITE_DATA_SOURCE=mock

# Базовый адрес публичного API (используется при VITE_DATA_SOURCE=api).
VITE_API_BASE=/api/v1/public/results

# Ссылка на Telegram-сообщество.
VITE_COMMUNITY_URL=https://t.me/+kieb_uZvVTdkZTQ6
